# Copy these variable names into the Claude Code routines UI (Environment Variables section).
# Never commit the actual values — fill them in the UI only.

# Required — Telegram delivery
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional — unlocks earnings-calendar and macro-regime-detector skills
# Free key at https://financialmodelingprep.com/developer/docs (250 calls/day)
FMP_API_KEY=your_fmp_key_here

# Optional — unlocks live macro data in Step 3D (Fed funds rate, CPI, yield curve)
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html (unlimited calls)
FRED_API_KEY=your_fred_key_here
